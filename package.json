{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_API_URL=http://127.0.0.1:8080 pnpm --filter @portal/web dev",
    "dev:api": "cargo run --bin portal-api",
    "build": "pnpm --filter @portal/web build && cargo build --release --bin portal-api",
    "start": "./target/release/portal-api",
    "lint": "pnpm --filter @portal/web lint",
    "db:seed": "cargo run --bin portal-seed"
  },
  "devDependencies": {}
}
